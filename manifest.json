{
    "manifest_version": 3,
    "name": "N3 Automation",
    "version": "1.0",
    "description": "Memudahkan pekerjaan anda",
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "permissions": [
        "activeTab",
        "scripting"
    ]
}